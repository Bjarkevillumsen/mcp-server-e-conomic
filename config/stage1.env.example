# Placeholders only. Copy to C:\ProgramData\EconomicMcp\config\stage1.env,
# restrict its ACL, and fill values outside source control.
NODE_ENV=production
STAGE1_PROFILE=true

PORT=3000
MCP_HTTP_HOST=127.0.0.1
MCP_PUBLIC_BASE_URL=https://mcp.example.com
MCP_ALLOWED_ORIGINS=https://approved-client.example.com
MCP_MAX_BODY_BYTES=1048576
MCP_REQUEST_TIMEOUT_MS=30000

ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_REQUIRED_SCOPE=Mcp.Access

ECONOMIC_ENABLE_WRITES=true
ECONOMIC_ENABLE_BOOKING=false
ECONOMIC_EXPECTED_AGREEMENT_NUMBER=1382005
ECONOMIC_POLICY_PATH=C:\ProgramData\EconomicMcp\config\economic-policy.stage1.json
ECONOMIC_AUDIT_LOG=C:\ProgramData\EconomicMcp\audit\audit.jsonl
ECONOMIC_TIMEOUT_MS=30000

ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_AGREEMENT_GRANT_TOKEN=

# Deliberately false in the service environment. Enable only in a temporary
# administrator shell when running an explicitly approved live write test.
ECONOMIC_ALLOW_LIVE_WRITE_TESTS=false
