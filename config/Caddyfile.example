{
	auto_https disable_redirects
	admin 127.0.0.1:2019
}

{{MCP_HOSTNAME}} {
	request_body {
		max_size 1MB
	}

	reverse_proxy 127.0.0.1:3000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 35s
		}
	}

	log {
		output file C:/ProgramData/Caddy/logs/access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
